# Copy to config/build.env and edit.
# Reproducible builds REQUIRE MOBILE_REF to be a full commit SHA, not master/main.

MOBILE_REPO="https://github.com/openjdk/mobile.git"
MOBILE_REF="<FULL_40_HEX_COMMIT_SHA>"

# macOS Boot JDK. The openjdk/mobile README currently names JDK 24;
# pin the concrete Boot JDK installation used by your build environment.
BOOT_JDK="/Library/Java/JavaVirtualMachines/jdk-24.jdk/Contents/Home"

# iOS support inputs. Do not rely on a particular support.zip directory layout:
# point these at the actual extracted locations.
LIBFFI_INCLUDE="/absolute/path/to/libffi/include"
LIBFFI_LIB_DIR="/absolute/path/to/libffi/libs"
CUPS_INCLUDE="/absolute/path/to/cups/include"

# Optional. Leave empty to use: xcrun --sdk iphoneos --show-sdk-path
IOS_SDK=""

# Parallelism for OpenJDK make. OpenJDK expects JOBS=N rather than make -jN.
JOBS="8"

# Build identity.
CONF_NAME="ios-aarch64-zero-tiny-release"

# Clean source/build worktree on each build. Keep 1 for reproducibility.
CLEAN_WORKTREE="1"
